.env

# local data
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# editors
.idea/
.vscode/

# macOS
.DS_Store

# The club's own pictures: the wordmark, the photographs of us, the artwork.
# None of them belong in a public repository, so none of them are in it — they
# live on the machine that serves the site, which is the only one that needs
# them. A checkout without them is not broken: the stylesheet lays a gradient
# under every photograph and the wordmark falls back to its own name, so the
# page renders as the design without the photography.
# The home-screen icons (icon-180/192/512.png) are made from the wordmark and
# so are covered by this too. The site still runs without them — it just
# cannot be installed on a phone, and says so in the log at startup.
web/static/*.png
web/static/*.jpg
web/static/*.jpeg
web/static/*.gif
web/static/*.webp
# Robert's mockup carries the same photographs base64'd inside it.
web/static/fcvino_dark_v2_preview.html
