# ---- Discord (required) --------------------------------------------------
# Developer Portal -> your application -> Bot -> Reset Token.
# Treat this like a password. If it ever leaks, hit Reset Token again.
DISCORD_TOKEN=

# Your server's ID. Discord app -> Settings -> Advanced -> Developer Mode ON,
# then right-click the FC Vino server -> Copy Server ID.
# Commands are registered to this one guild, which makes them appear instantly
# (global registration can take up to an hour).
DISCORD_GUILD_ID=

# ---- Football data (optional; /football and /predict need it) ------------
# Free key: https://www.football-data.org/client/register  (arrives by email)
FOOTBALL_DATA_TOKEN=

# ---- Optional knobs -----------------------------------------------------
# Where the SQLite file lives (relative paths resolve from the repo root).
FCVINO_DB_PATH=data/fcvino.sqlite3

# Used for date headers and matchweek grouping. Kickoff times themselves are
# rendered by Discord in each reader's own timezone.
FCVINO_TZ=Europe/Oslo

# How long before kickoff a reminder is posted.
REMINDER_LEAD_MINUTES=60

# Competitions that get automatic kickoff reminders. Every member's favourite
# club is always reminded regardless of what's listed here.
# Set this to just CL if a full Premier League slate turns out too noisy.
REMINDER_COMPETITIONS=PL,CL

# Competition the prediction game runs on.
PREDICTION_COMPETITION=PL

# DEBUG for verbose discord.py logs.
LOG_LEVEL=INFO

# ---- Web app (needed by `uvicorn web.app:app`, not by the bot) -----------
# One passphrase shared with the club. Anyone who has it can sign in and then
# pick which member they are, so treat it as the key to nine people's notes.
WEB_PASSWORD=

# Signs the session cookie. Leave blank and one is generated per start, which
# just means everyone is signed out when you restart. Set it — `python -c
# "import secrets; print(secrets.token_hex(32))"` — once this is hosted.
WEB_SESSION_SECRET=

# ---- Cloudflare Access (only when the app is behind the tunnel) ----------
# Set this to 1 and Access does the signing in: whoever it vouched for by email
# is let straight through, and WEB_PASSWORD is never asked for. Leave it unset
# on a laptop — the app must not trust the header unless Cloudflare is the only
# way to reach it. See web/access.py.
FCVINO_ACCESS=

# Usually leave this empty. A name is read off the address — sigurd@…, and even
# havard@… for Håvard — so the club's addresses only have to be listed in the
# Cloudflare policy, not here as well. This is for the ones that don't match:
# a work address spelling the name differently, or a shared alias. It also
# overrules a wrong guess. Pairs of email=Name, comma separated; kept out of the
# database because this repository is public.
# e.g. FCVINO_ACCESS_MEMBERS=t.pleym@work.example.com=Sigurd
FCVINO_ACCESS_MEMBERS=

# ---- Reading a wine's label from a photograph (optional) ----------------
# With a key here the "Add a bottle" panel on an event offers to photograph the
# label and fills the form in from it; a person still checks it and presses Add.
# Without one the control is not shown and bottles are typed in as before.
# Key: https://console.anthropic.com/  — about a tenth of a krone per bottle.
# The photo is sent to be read and then dropped; it is never saved or logged.
ANTHROPIC_API_KEY=
